# Used by `docker compose` (it reads .env automatically). Copy to .env; never commit .env.
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

# The application reads settings from config.properties, and any of them can be
# overridden by an OS environment variable named after the key, upper-cased,
# dots replaced by underscores (db.url -> DB_URL). Export these in your shell
# or set them in your run configuration / hosting provider:
#   DB_URL=jdbc:postgresql://localhost:5432/app
#   DB_USER=app
#   DB_PASSWORD=app
#   DB_POOL_MAX=10
